{
  "appId": "io.github.bearbabybaby_ai.bearbao",
  "appName": "熊寶系統",
  "webDir": "www",
  "server": {
    "url": "https://bearbabybaby-ai.github.io/bearbao/",
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "adjustMarginsForEdgeToEdge": "disable"
  },
  "plugins": {
    "BackgroundRunner": {
      "label": "io.github.bearbabybaby_ai.bearbao.reminders",
      "src": "runners/reminders.js",
      "event": "checkReminders",
      "repeat": true,
      "interval": 15,
      "autoStart": true
    }
  }
}
