{
  "name": "bearbao-desktop",
  "productName": "熊寶系統",
  "version": "1.2.0",
  "description": "熊寶系統",
  "main": "main.js",
  "author": "BearBabyBaby-ai",
  "private": true,
  "scripts": {
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.bearbabybaby_ai.bearbao",
    "productName": "熊寶系統",
    "artifactName": "bearbao-setup.${ext}",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "reminders.js", "icon.png", "package.json"],
    "win": { "icon": "icon.png", "target": ["nsis"] },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "熊寶系統",
      "language": "1028"
    }
  }
}
